{
  "language": "fr",
  "topic": "French core: essentials for real conversations",
  "level": "A1-A2",
  "items": [
    { "target": "bonjour", "english": "hello, good day", "pronunciation": "/bɔ̃.ʒuʁ/", "example": "Bonjour, je m'appelle Marie.", "example_en": "Hello, my name is Marie.", "note": "Default polite greeting until the evening; after ~18h use « bonsoir ».", "tags": ["greetings", "essential"] },
    { "target": "merci beaucoup", "english": "thank you very much", "pronunciation": "/mɛʁ.si bo.ku/", "example": "Merci beaucoup pour votre aide.", "example_en": "Thank you very much for your help.", "note": "", "tags": ["greetings", "essential"] },
    { "target": "s'il vous plaît", "english": "please (formal)", "pronunciation": "/sil vu plɛ/", "example": "Un café, s'il vous plaît.", "example_en": "A coffee, please.", "note": "Informal version: « s'il te plaît ».", "tags": ["greetings", "essential"] },
    { "target": "excusez-moi", "english": "excuse me", "pronunciation": "/ɛk.sky.ze mwa/", "example": "Excusez-moi, où est la gare ?", "example_en": "Excuse me, where is the station?", "note": "Use it to get attention politely before a question.", "tags": ["greetings", "essential"] },
    { "target": "je voudrais", "english": "I would like", "pronunciation": "/ʒə vu.dʁɛ/", "example": "Je voudrais un croissant.", "example_en": "I would like a croissant.", "note": "Polite conditional of « vouloir » - the default way to order anything.", "tags": ["café", "verbs", "chunk"] },
    { "target": "il y a", "english": "there is, there are", "pronunciation": "/il i a/", "example": "Il y a un problème.", "example_en": "There is a problem.", "note": "Invariable chunk - same form for singular and plural.", "tags": ["chunk", "essential"] },
    { "target": "combien", "english": "how much, how many", "pronunciation": "/kɔ̃.bjɛ̃/", "example": "C'est combien ?", "example_en": "How much is it?", "note": "", "tags": ["questions", "shopping"] },
    { "target": "où", "english": "where", "pronunciation": "/u/", "example": "Où sont les toilettes ?", "example_en": "Where are the toilets?", "note": "The accent distinguishes it from « ou » (or).", "tags": ["questions", "essential"] },
    { "target": "parler", "english": "to speak", "pronunciation": "/paʁ.le/", "example": "Je parle un peu français.", "example_en": "I speak a little French.", "note": "Regular -er verb.", "tags": ["verbs"] },
    { "target": "comprendre", "english": "to understand", "pronunciation": "/kɔ̃.pʁɑ̃dʁ/", "example": "Je ne comprends pas.", "example_en": "I don't understand.", "note": "Irregular, like « prendre » : je comprends, nous comprenons.", "tags": ["verbs", "essential"] },
    { "target": "manger", "english": "to eat", "pronunciation": "/mɑ̃.ʒe/", "example": "On mange à midi ?", "example_en": "Shall we eat at noon?", "note": "« On » + 3rd person singular is the everyday way to say 'we'.", "tags": ["verbs", "food"] },
    { "target": "boire", "english": "to drink", "pronunciation": "/bwaʁ/", "example": "Tu veux boire quelque chose ?", "example_en": "Do you want to drink something?", "note": "Irregular: je bois, nous buvons, ils boivent.", "tags": ["verbs", "food"] },
    { "target": "l'eau", "english": "water", "pronunciation": "/lo/", "example": "Une carafe d'eau, s'il vous plaît.", "example_en": "A jug of water, please.", "note": "Feminine noun: « une eau », « l'eau froide ».", "tags": ["food", "nouns"] },
    { "target": "le pain", "english": "bread", "pronunciation": "/pɛ̃/", "example": "Le pain est encore chaud.", "example_en": "The bread is still warm.", "note": "Nasal vowel /ɛ̃/ - same sound as in « vin ».", "tags": ["food", "nouns"] },
    { "target": "la gare", "english": "train station", "pronunciation": "/gaʁ/", "example": "La gare est à dix minutes à pied.", "example_en": "The station is ten minutes away on foot.", "note": "« La gare » = trains; « la station » = metro.", "tags": ["city", "nouns"] },
    { "target": "le billet", "english": "ticket", "pronunciation": "/bi.jɛ/", "example": "J'ai acheté un billet aller-retour.", "example_en": "I bought a round-trip ticket.", "note": "« Billet » for trains/planes; « ticket » for metro/bus.", "tags": ["city", "nouns"] },
    { "target": "à droite", "english": "to the right", "pronunciation": "/a dʁwat/", "example": "Tournez à droite après le pont.", "example_en": "Turn right after the bridge.", "note": "", "tags": ["directions", "chunk"] },
    { "target": "à gauche", "english": "to the left", "pronunciation": "/a goʃ/", "example": "La pharmacie est à gauche.", "example_en": "The pharmacy is on the left.", "note": "", "tags": ["directions", "chunk"] },
    { "target": "tout droit", "english": "straight ahead", "pronunciation": "/tu dʁwa/", "example": "Continuez tout droit jusqu'au feu.", "example_en": "Keep going straight until the traffic light.", "note": "Don't confuse « tout droit » (straight) with « à droite » (right).", "tags": ["directions", "chunk"] },
    { "target": "aujourd'hui", "english": "today", "pronunciation": "/o.ʒuʁ.dɥi/", "example": "Aujourd'hui, il fait beau.", "example_en": "Today the weather is nice.", "note": "", "tags": ["time"] },
    { "target": "demain", "english": "tomorrow", "pronunciation": "/də.mɛ̃/", "example": "À demain !", "example_en": "See you tomorrow!", "note": "", "tags": ["time"] },
    { "target": "hier", "english": "yesterday", "pronunciation": "/jɛʁ/", "example": "Hier soir, je suis rentré tard.", "example_en": "Last night I got home late.", "note": "", "tags": ["time"] },
    { "target": "maintenant", "english": "now", "pronunciation": "/mɛ̃t.nɑ̃/", "example": "On peut commencer maintenant.", "example_en": "We can start now.", "note": "", "tags": ["time"] },
    { "target": "toujours", "english": "always, still", "pronunciation": "/tu.ʒuʁ/", "example": "Il est toujours en retard.", "example_en": "He is always late.", "note": "Context decides between 'always' and 'still': « Tu habites toujours ici ? » = still.", "tags": ["adverbs"] },
    { "target": "déjà", "english": "already", "pronunciation": "/de.ʒa/", "example": "Tu as déjà fini ?", "example_en": "Have you finished already?", "note": "", "tags": ["adverbs"] },
    { "target": "peut-être", "english": "maybe, perhaps", "pronunciation": "/pø.tɛtʁ/", "example": "Peut-être demain, je ne sais pas encore.", "example_en": "Maybe tomorrow, I don't know yet.", "note": "", "tags": ["adverbs"] },
    { "target": "bien sûr", "english": "of course", "pronunciation": "/bjɛ̃ syʁ/", "example": "Bien sûr, avec plaisir !", "example_en": "Of course, with pleasure!", "note": "", "tags": ["chunk", "conversation"] },
    { "target": "d'accord", "english": "okay, agreed", "pronunciation": "/da.kɔʁ/", "example": "D'accord, on se voit à huit heures.", "example_en": "Okay, see you at eight.", "note": "« Être d'accord » = to agree: « Je suis d'accord avec toi. »", "tags": ["chunk", "conversation"] },
    { "target": "la semaine", "english": "week", "pronunciation": "/sə.mɛn/", "example": "La semaine prochaine, je pars à Lyon.", "example_en": "Next week I'm leaving for Lyon.", "note": "", "tags": ["time", "nouns"] },
    { "target": "le travail", "english": "work, job", "pronunciation": "/tʁa.vaj/", "example": "J'ai beaucoup de travail cette semaine.", "example_en": "I have a lot of work this week.", "note": "Final -il sounds like /j/: « travail », « soleil ».", "tags": ["nouns", "daily life"] },
    { "target": "acheter", "english": "to buy", "pronunciation": "/aʃ.te/", "example": "Je dois acheter du pain.", "example_en": "I have to buy some bread.", "note": "Stem change: j'achète /a.ʃɛt/ but nous achetons.", "tags": ["verbs", "shopping"] },
    { "target": "chercher", "english": "to look for", "pronunciation": "/ʃɛʁ.ʃe/", "example": "Je cherche la rue Victor Hugo.", "example_en": "I'm looking for Victor Hugo street.", "note": "No preposition: « chercher quelque chose » (not 'chercher pour').", "tags": ["verbs"] },
    { "target": "trouver", "english": "to find", "pronunciation": "/tʁu.ve/", "example": "Je ne trouve pas mes clés.", "example_en": "I can't find my keys.", "note": "", "tags": ["verbs"] },
    { "target": "penser", "english": "to think", "pronunciation": "/pɑ̃.se/", "example": "Qu'est-ce que tu en penses ?", "example_en": "What do you think about it?", "note": "« en » replaces « de + thing » - a very common pattern.", "tags": ["verbs", "conversation"] },
    { "target": "avoir besoin de", "english": "to need", "pronunciation": "/a.vwaʁ bə.zwɛ̃ də/", "example": "J'ai besoin d'un peu de temps.", "example_en": "I need a little time.", "note": "Literally 'to have need of' - always with « de ».", "tags": ["chunk", "verbs"] },
    { "target": "avoir envie de", "english": "to feel like, to want", "pronunciation": "/a.vwaʁ ɑ̃.vi də/", "example": "J'ai envie d'un café.", "example_en": "I feel like a coffee.", "note": "Softer than « vouloir »; also « avoir envie de + infinitive ».", "tags": ["chunk", "verbs"] },
    { "target": "il faut", "english": "it is necessary, you have to", "pronunciation": "/il fo/", "example": "Il faut réserver à l'avance.", "example_en": "You have to book in advance.", "note": "Impersonal - only exists with « il ». Followed by infinitive or « que » + subjunctive.", "tags": ["chunk", "grammar"] },
    { "target": "trop", "english": "too, too much", "pronunciation": "/tʁo/", "example": "C'est trop cher.", "example_en": "It's too expensive.", "note": "Informally also 'very': « C'est trop bien ! »", "tags": ["adverbs"] },
    { "target": "assez", "english": "enough, quite", "pronunciation": "/a.se/", "example": "Le film était assez long.", "example_en": "The film was quite long.", "note": "« assez de » + noun = enough of: « assez de temps ».", "tags": ["adverbs"] },
    { "target": "quelque chose", "english": "something", "pronunciation": "/kɛl.kə ʃoz/", "example": "Il y a quelque chose qui ne va pas.", "example_en": "There is something wrong.", "note": "", "tags": ["pronouns"] },
    { "target": "quelqu'un", "english": "someone", "pronunciation": "/kɛl.kœ̃/", "example": "Quelqu'un a appelé pour toi.", "example_en": "Someone called for you.", "note": "", "tags": ["pronouns"] },
    { "target": "rien", "english": "nothing", "pronunciation": "/ʁjɛ̃/", "example": "Ce n'est rien.", "example_en": "It's nothing.", "note": "Needs « ne » in full sentences: « Je ne vois rien. »", "tags": ["pronouns", "negation"] },
    { "target": "tout le monde", "english": "everyone", "pronunciation": "/tu lə mɔ̃d/", "example": "Tout le monde est là.", "example_en": "Everyone is here.", "note": "Takes a singular verb, unlike English 'everyone are'.", "tags": ["chunk", "pronouns"] },
    { "target": "souvent", "english": "often", "pronunciation": "/su.vɑ̃/", "example": "On va souvent au marché le samedi.", "example_en": "We often go to the market on Saturdays.", "note": "", "tags": ["adverbs"] },
    { "target": "parce que", "english": "because", "pronunciation": "/paʁs.kə/", "example": "Je reste parce que je suis fatigué.", "example_en": "I'm staying because I'm tired.", "note": "Answer to « pourquoi ». Becomes « parce qu' » before a vowel.", "tags": ["connectors"] },
    { "target": "donc", "english": "so, therefore", "pronunciation": "/dɔ̃k/", "example": "Je pense, donc je suis.", "example_en": "I think, therefore I am.", "note": "", "tags": ["connectors"] },
    { "target": "mais", "english": "but", "pronunciation": "/mɛ/", "example": "C'est petit mais confortable.", "example_en": "It's small but comfortable.", "note": "Sounds exactly like « mets » and « mai » - context decides.", "tags": ["connectors"] },
    { "target": "pourquoi", "english": "why", "pronunciation": "/puʁ.kwa/", "example": "Pourquoi pas ?", "example_en": "Why not?", "note": "", "tags": ["questions"] }
  ]
}
