# Copy this file to .env and fill in what you use. Never commit .env.

# Preferred LLM provider: OpenRouter (https://openrouter.ai/keys).
# Powers lesson generation, story generation, and tap-to-define.
OPENROUTER_API_KEY=""

# Model served through OpenRouter (default: DeepSeek v4 Flash).
# LEARNLANGUAGE_MODEL="deepseek/deepseek-v4-flash-0731"

# Optional fallback: direct OpenAI. Used only when no OpenRouter key is set.
# OPENAI_API_KEY=""
# LEARNLANGUAGE_OPENAI_MODEL="gpt-4o-mini"

# Optional overrides
# LEARNLANGUAGE_DEFAULT_LANGUAGE="fr"
# LEARNLANGUAGE_LLM_TIMEOUT="60"
